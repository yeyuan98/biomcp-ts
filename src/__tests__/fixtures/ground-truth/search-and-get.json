{
  "lastVerified": "2026-04-25",
  "tests": [
    {
      "tool": "gene_search",
      "input": { "query": "BRCA1" },
      "stableAssertions": [
        { "description": "BRCA1 symbol found in results", "check": "findSymbol", "value": "BRCA1" },
        { "description": "BRCA1 Entrez ID", "check": "findField", "symbol": "BRCA1", "field": "entrez_id", "value": 672 }
      ]
    },
    {
      "tool": "gene_search",
      "input": { "query": "TP53" },
      "stableAssertions": [
        { "description": "TP53 symbol found in results", "check": "findSymbol", "value": "TP53" },
        { "description": "TP53 Entrez ID", "check": "findField", "symbol": "TP53", "field": "entrez_id", "value": 7157 }
      ]
    },
    {
      "tool": "gene_get",
      "input": { "symbol": "BRCA1" },
      "stableAssertions": [
        { "description": "symbol is BRCA1", "check": "fieldEquals", "field": "symbol", "value": "BRCA1" }
      ]
    },
    {
      "tool": "drug_search",
      "input": { "query": "aspirin" },
      "stableAssertions": [
        { "description": "aspirin InChIKey", "check": "findField", "symbol": null, "field": "inchi_key", "value": "BSYNRYMUTXBXSQ-UHFFFAOYSA-N" }
      ]
    },
    {
      "tool": "drug_get",
      "input": { "name": "aspirin" },
      "stableAssertions": [
        { "description": "name contains aspirin", "check": "fieldContains", "field": "name", "value": "Aspirin" }
      ]
    },
    {
      "tool": "variant_search",
      "input": { "query": "rs113488022" },
      "stableAssertions": [
        { "description": "rs113488022 found in results", "check": "findField", "symbol": null, "field": "id", "value": "rs113488022" }
      ]
    },
    {
      "tool": "variant_get",
      "input": { "id": "rs113488022" },
      "stableAssertions": [
        { "description": "id contains rs113488022", "check": "fieldContains", "field": "id", "value": "rs113488022" }
      ]
    },
    {
      "tool": "disease_search",
      "input": { "query": "breast cancer" },
      "stableAssertions": [
        { "description": "breast cancer MONDO ID found", "check": "findFieldByPrefix", "field": "disease_id", "prefix": "MONDO:", "value": "0007254" }
      ]
    },
    {
      "tool": "disease_get",
      "input": { "disease_id": "MONDO:0007254" },
      "stableAssertions": [
        { "description": "name contains breast cancer", "check": "fieldContainsIgnoreCase", "field": "name", "value": "breast cancer" }
      ]
    },
    {
      "tool": "trial_search",
      "input": { "query": "breast cancer" },
      "stableAssertions": [
        { "description": "results have NCT IDs", "check": "firstFieldMatches", "field": "nct_id", "pattern": "^NCT\\d+$" }
      ]
    },
    {
      "tool": "article_search",
      "input": { "query": "BRCA1", "source": "pubmed" },
      "stableAssertions": [
        { "description": "results have titles", "check": "firstFieldExists", "field": "title" }
      ]
    }
  ]
}
