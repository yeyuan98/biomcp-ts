# BioMCP Remote Self-Hosting Environment Configuration

# Server network settings
BIOMCP_HOST=0.0.0.0
BIOMCP_PORT=3000
BIOMCP_DOMAIN=mcp.example.com
BIOMCP_UPSTREAM=biomcp
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# Authentication (Bearer tokens for MCP clients)
# Format: token or comma-separated token:label pairs
BIOMCP_AUTH_TOKENS=sec_demo_lab123:lab-team,sec_agent_456:claude-agent

# Traffic & Tool Execution Tracing
BIOMCP_TRACE=true
BIOMCP_TRACE_FILE=/data/traces/biomcp.jsonl

# Upstream Biomedical API Keys (shared centrally with all authenticated users)
NCBI_API_KEY=
NCBI_EMAIL=
S2_API_KEY=
OPENFDA_API_KEY=
ONCOKB_TOKEN=
DISGENET_API_KEY=
CROSSREF_EMAIL=
EPO_OPS_CONSUMER_KEY=
EPO_OPS_CONSUMER_SECRET=
USPTO_API_KEY=

# Optional sandboxed analysis features
ANALYSIS_R=0
ANALYSIS_BIOWASM=0
DB_TYPE=
