{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "types": ["jest", "node"]
  },
  "include": ["src/**/*", "scripts/**/*"],
  // NOTE: src/__tests__/server is excluded TEMPORARILY — those tests are being
  // fixed by a parallel workstream. Remove this entry once their type errors
  // (Jest 30 bare jest.fn() mock patterns, 26 errors as of 2026-10-15) are
  // fixed so the whole test suite is covered by this config.
  "exclude": ["node_modules", "dist", "src/__tests__/server"]
}
